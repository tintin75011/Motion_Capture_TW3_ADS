{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_POLICY_VERSION_MINIMUM": "3.5"
      }
    },
    {
      "name": "ninja-release",
      "displayName": "Ninja - Release (MinGW g++)",
      "description": "Build Release avec Ninja et g++ (recommandé, sans Visual Studio)",
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "ninja-debug",
      "displayName": "Ninja - Debug (MinGW g++)",
      "description": "Build Debug avec Ninja et g++ (symboles de debug, -g -O0)",
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "vs2022-release",
      "displayName": "Visual Studio 2022 x64 - Release",
      "description": "Build Release avec MSVC (nécessite Visual Studio 2022 ou Build Tools)",
      "inherits": "base",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build-vs",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "vs2022-debug",
      "displayName": "Visual Studio 2022 x64 - Debug",
      "description": "Build Debug avec MSVC",
      "inherits": "vs2022-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ],
  "buildPresets": [
    { "name": "ninja-release", "configurePreset": "ninja-release" },
    { "name": "ninja-debug", "configurePreset": "ninja-debug" },
    { "name": "vs2022-release", "configurePreset": "vs2022-release" },
    { "name": "vs2022-debug", "configurePreset": "vs2022-debug" }
  ],
  "testPresets": [
    { "name": "ninja-release", "configurePreset": "ninja-release" },
    { "name": "ninja-debug", "configurePreset": "ninja-debug" }
  ]
}